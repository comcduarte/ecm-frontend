{% extends '@layout/default.html.twig' %}

{% block title %}Department Dashboard{% endblock %}

{% block page_title %}{% endblock %}

{% block content %}

<div class='container'>
	<div class='row'>
		<div class='col'>
			<div class="container">
				<div class="row header-row">
					<div class="col">Folder ID</div>
					<div class="col">Project Name</div>
					<div class="col">Current Progress</div>
				</div>
				{% for record in contracts[0] %}
				<div class="row data-row">
					<div class="col">
						<a href="{{ url('contract::view-contract-form', {'id': record.folder_id}) }}">{{ record.folder_id }}</a>
					</div>
					<div class="col">{{ record.project_name }}</div>
					<div class="col">
						<div class="progress">
							<div class="progress-bar bg-success" role="progressbar"
								style="width: {{ record.progress }}%"
								aria-valuenow="{{ record.progress }}" aria-valuemin="0"
								aria-valuemax="50"></div>
						</div>
					</div>
				</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>


{% endblock %}