{% extends '@layout/default.html.twig' %}

{% block title %}
Select Contract
{% endblock %}

{% block content %}
<div class="page-intro home-intro">
	<div class="container">
		<p class="welcome"></p>
		<h1>Select Contract</h1>
	</div>
	<div class="arrow_down">
		<div class="arrow_down_content">&nbsp;</div>
	</div>
</div>
<div class="container" style="margin-top: 100px;">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
    	
    	<div class="col">
    		<div class="card shadow-sm">
    			<div class="card-header">
    				Uniform Contract for Goods and Services
    			</div>
    			<div class="card-body">
    				<p class="card-text">This is a wider card with supporting text
    					below as a natural lead-in to additional content. This content is a
    					little bit longer.</p>
    				<div class="d-flex justify-content-between align-items-center">
    					<div class="btn-group">
    						<a href="{{ url('contract::create-contract-form', {'form': 'ucgs'}) }}" class="btn btn-sm btn-outline-secondary">Create</a>
    					</div>
    					<small class="text-body-secondary"></small>
    				</div>
    			</div>
    		</div>
    	</div>
    	
    	<div class="col">
    		<div class="card shadow-sm">
    			<div class="card-header">
    				Uniform Contract for Labor/Trade Services over $100,000.00
    			</div>
    			<div class="card-body">
    				<p class="card-text">
    					A form is unavailable for this document at this time.  Please click on the link below to download a Word Document.
    					Fill out the document in its entirety, and then upload to the ECM with the Import feature.
					</p>
    				<div class="d-flex justify-content-between align-items-center">
    					<div class="btn-group">
    						<a href="{{ url('contract::create-contract-form', {'form': 'uclts'}) }}" class="btn btn-sm btn-outline-secondary">Create</a>
{#							<a href="https://middletownct.box.com/s/aewm56c52s2rvrsr0j21zi0d4tf0yw9r" class="btn btn-sm btn-outline-primary">Download</a> #}
    					</div>
    					<small class="text-body-secondary"></small>
    				</div>
    			</div>
    		</div>
    	</div>
    	
    	<div class="col">
    		<div class="card shadow-sm">
    			<div class="card-header">
    				Cooperative Contract
    			</div>
    			<div class="card-body">
    				<p class="card-text">This is a wider card with supporting text
    					below as a natural lead-in to additional content. This content is a
    					little bit longer.</p>
    				<div class="d-flex justify-content-between align-items-center">
    					<div class="btn-group">
    						<a href="{{ url('cc::get-create') }}" class="btn btn-sm btn-outline-secondary">Create</a>
    					</div>
    				</div>
    			</div>
    		</div>
    	</div>
    	
    	<div class="col">
    		<div class="card shadow-sm">
    			<div class="card-header">
    				Amendment
    			</div>
    			<div class="card-body">
    				<p class="card-text">When uploading an amendmend, it can be saved as either a docx or pdf.</p>
    				<div class="d-flex justify-content-between align-items-center">
    					<div class="btn-group">
    						<a href="{{ url('amendment::get-create') }}" class="btn btn-sm btn-outline-secondary">Create</a>
    					</div>
    				</div>
    			</div>
    		</div>
    	</div>
    </div>
</div>
{% endblock %}