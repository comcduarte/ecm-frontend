{% extends '@layout/default.html.twig' %}

{% block title %}View Contract{% endblock %}
{% block body_class %}vh-100{% endblock %}

{% set id = id %}

{% block content %}
<div class="container-fluid p-0 h-100">
	<div class="row h-100">
		<div class="bg-white col col-9">
			<object class="vh-100" data="data:application/pdf;base64,{{ image }}" type="application/pdf" width="100%">
				<p>Your browser will not display PDFs</p>
			</object>
		</div>
		<div class="col col-3">
			<div class="d-flex flex-column p-3 text-bg-dark h-100">
				<div class="h-50">
    				<h3 class="text-bg-dark">Metadata</h3>
    				<hr>
    				{% for instance in metadata_instances.entries %}
    					Queue: {{ instance.queue }}<br>
    					Contract ID: {{ instance.contractnumber }}<br>
    				{% endfor %}
				</div>
				<div class="h-50">
    				<h3 class="text-bg-dark">Comments</h3>
    				<hr>
    				{% for comment in comments.entries %}
    					- {{ comment.message }}<br>
    				{% endfor %}
				</div>
				<div class="h-50">
    				<h3 class="text-bg-dark">Supporting Documentation</h3>
    				<hr>
    				{% for document in supporting_documentation.entries %}
    					- {{ document.name }}<br>
    				{% endfor %}
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}