{% extends '@layout/default.html.twig' %}

{% block title %}List Templates{% endblock %}

{% block content %}
<div class="page-intro">
	<div class="container">
		<h1>List &raquo; Templates</h1>
	</div>
</div>
<div class="container">
	<ul class="list-group">
	{% for item in templates %}
		<li class="list-group-item">{{ item.name }}
	{% endfor %}
	</ul>
</div>
{% endblock %}