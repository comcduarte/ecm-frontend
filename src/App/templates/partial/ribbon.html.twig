{% set active_classes = 'show active ribbon' %}

{% set file_active = '' %}
{% set workflow_active = '' %}
{% set home_active = '' %}
{% set document_active = '' %}

{% if active == 'workflow' %}
	{% set workflow_active = active_classes %}
{% elseif active == 'document' %}
	{% set document_active = active_classes %}
{% elseif active == 'file' %}
	{% set file_active = active_classes %}
{% else %}
	{% set home_active = active_classes %}
{% endif %}

<ul class="nav nav-tabs" id="myTab" role="tablist">
	<li class="nav-item" role="presentation">
		<button class="nav-link {{ file_active }}" id="file-tab" data-bs-toggle="tab"
			data-bs-target="#file-tab-pane" type="button" role="tab"
			aria-controls="file-tab-pane" aria-selected="false">File</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link {{ home_active }}" id="home-tab" data-bs-toggle="tab"
			data-bs-target="#home-tab-pane" type="button" role="tab"
			aria-controls="home-tab-pane" aria-selected="false">Home</button>
	</li>

	<li class="nav-item" role="presentation">
		<button class="nav-link {{ workflow_active }}" id="workflow-tab" data-bs-toggle="tab"
			data-bs-target="#workflow-tab-pane" type="button" role="tab"
			aria-controls="workflow-tab-pane" aria-selected="true">Workflow</button>
	</li>
	<li class="nav-item" role="presentation">
		<button class="nav-link {{ document_active }}" id="document-tab" data-bs-toggle="tab"
			data-bs-target="#document-tab-pane" type="button" role="tab"
			aria-controls="document-tab-pane" aria-selected="false">Document</button>
	</li>
</ul>
<div class="tab-content" id="myTabContent">
	<!-- FILE RIBBON -->
	<div class="tab-pane fade {{ file_active }}" id="file-tab-pane" role="tabpanel"
		aria-labelledby="file-tab" tabindex="0"></div>

	<!-- HOME RIBBON -->
	<div class="tab-pane fade {{ home_active }}" id="home-tab-pane"
		role="tabpanel" aria-labelledby="home-tab" tabindex="0">
		<div class="card-group">

			<!--  FAVORITES CARD -->
			<div class="card" style="flex: unset;">
				<div class="card-body">
{# 					<button class="btn d-inline-flex flex-column">#}
					<a href="{{ url('home', {'action': 'dashboard'}) }}" class="btn d-inline-flex flex-column">
						<i class="fas fa-house fa-2x"></i>
						<span>Home</span>
					</a>
				</div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">Favorites</span>
					<div class="d-inline-flex">
						<i class="fas fa-caret-down"
							style="color: lightgrey; transform: translateY(50%) translateX(100%) rotate(-45deg);"></i>
					</div>
				</div>
			</div>

			<!-- DOCUMENTS CARD -->
			<div class="card" style="flex: unset;">
				<div class="card-body">
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-search fa-2x"></i> <span>Search</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-archive fa-2x"></i> <span>File Archive</span>
					</button>
				</div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">Documents</span>
					<div class="d-inline-flex">
						<i class="fas fa-caret-down"
							style="color: lightgrey; transform: translateY(50%) translateX(100%) rotate(-45deg);"></i>
					</div>
				</div>
			</div>


			<!-- CREATE CARD -->
			<div class="card" style="flex: unset;">
				<div class="card-body">
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-file fa-2x"></i> <span>Forms</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-upload fa-2x"></i> <span>Import</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-th-list fa-2x"></i> <span>Templates</span>
					</button>
				</div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">Create</span>
					<div class="d-inline-flex">
						<i class="fas fa-caret-down"
							style="color: lightgrey; transform: translateY(50%) translateX(100%) rotate(-45deg);"></i>
					</div>
				</div>
			</div>

			<!-- TASKS CARD -->
			<div class="card" style="flex: unset;">
				<div class="card-body">
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-check-circle fa-2x"></i> <span>Approve</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-times-circle fa-2x"></i> <span>Reject</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-plus-circle fa-2x"></i> <span>Add
							Supporting Documents</span>
					</button>
					<button class="btn d-inline-flex flex-column">
						<i class="fas fa-question-circle fa-2x"></i> <span>COI
							Needed from Dept Head or Vendor</span>
					</button>
				</div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">Tasks</span>
					<div class="d-inline-flex">
						<i class="fas fa-caret-down"
							style="color: lightgrey; transform: translateY(50%) translateX(100%) rotate(-45deg);"></i>
					</div>
				</div>
			</div>

			<!-- END -->
			<div class="card">
				<div class="card-body"></div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">&nbsp;</span>
					<div class="d-inline-flex">
						<i class="fas fa-thumbtack-slash"
							style="transform: translateY(10px) translateX(10px) rotate(-45deg);"></i>
					</div>
				</div>
			</div>

		</div>

	</div>

	<!-- WORKFLOW RIBBON -->
	<div class="tab-pane fade {{ workflow_active }}" id="workflow-tab-pane"
		role="tabpanel" aria-labelledby="workflow-tab" tabindex="0">
		<div class="card-group">
			<div class="card" style="flex: unset;">
				<div class="card-body">
					<a href="{{ url('workflow', {'action': 'index'}) }}" class="btn d-inline-flex flex-column">
						<i class="fas fa-right-left fa-2x"></i>
						<span>Workflow</span>
					</a>
				</div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">Workflow</span>
					<div class="d-inline-flex">
						<i class="fas fa-caret-down"
							style="color: lightgrey; transform: translateY(50%) translateX(100%) rotate(-45deg);"></i>
					</div>
				</div>
			</div>
		
			<!-- END -->
			<div class="card">
				<div class="card-body"></div>
				<div class="d-flex card-footer">
					<span class="flex-grow-1">&nbsp;</span>
					<div class="d-inline-flex">
						<i class="fas fa-thumbtack-slash"
							style="transform: translateY(10px) translateX(10px) rotate(-45deg);"></i>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- DOCUMENT RIBBON -->
	<div class="tab-pane fade {{ document_active }}" id="document-tab-pane" role="tabpanel"
		aria-labelledby="document-tab" tabindex="0"></div>
</div>

