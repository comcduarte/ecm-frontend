{% set active_classes = 'show active ribbon' %}

{% set file_active = '' %}
{% set workflow_active = '' %}
{% set home_active = '' %}
{% set document_active = '' %}

{% if active == 'workflow' %}
	{% set workflow_active = active_classes %}
{% elseif active == 'document' %}
	{% set document_active = active_classes %}
{% elseif active == 'file' %}
	{% set file_active = active_classes %}
{% else %}
	{% set home_active = active_classes %}
{% endif %}

